# GitHub Fleet Manager Environment Configuration
# Kopieer deze file naar .env en vul de waarden in

# =============================================================================
# GitHub Tokens
# =============================================================================
# Token voor itsdarklikehell repositories
GH_TOKEN_ITSDARKLIKEHELL=

# Token voor hmol33 repositories
GH_TOKEN_HMOL33=

# =============================================================================
# Telegram (optioneel)
# =============================================================================
# Token voor Telegram bot
TELEGRAM_TOKEN=

# Chat ID voor Telegram notificaties
TELEGRAM_CHAT_ID=

# =============================================================================
# Script Configuration
# =============================================================================
# Algemene instellingen
LOG_LEVEL=info
LOG_DIR=/home/hans/.hermes/cron

# Release Automation
RA_ENABLED=yes
RA_DRY_RUN=yes
RA_REPO=
RA_ORG=itsdarklikehell

# Changelog Generator
CG_ENABLED=yes
CG_DRY_RUN=yes
CG_REPO=
CG_ORG=itsdarklikehell

# Secret Scanning
SS_ENABLED=yes
SS_DRY_RUN=yes
SS_REPO=
SS_ORG=itsdarklikehell

# License Compliance Check
LCC_ENABLED=yes
LCC_DRY_RUN=yes
LCC_REPO=
LCC_ORG=itsdarklikehell

# Repo Health Score
RHS_ENABLED=yes
RHS_DRY_RUN=yes
RHS_REPO=
RHS_ORG=itsdarklikehell

# Security Advisory Monitor
SAM_ENABLED=yes
SAM_DRY_RUN=yes
SAM_REPO=
SAM_ORG=itsdarklikehell

# Code Quality Metrics
CQM_ENABLED=yes
CQM_DRY_RUN=yes
CQM_REPO=
CQM_ORG=itsdarklikehell

# Automated Dependency Updates
ADU_ENABLED=yes
ADU_DRY_RUN=yes
ADU_REPO=
ADU_ORG=itsdarklikehell

# Branch Protection Enforcement
BPE_ENABLED=yes
BPE_DRY_RUN=yes
BPE_REPO=
BPE_ORG=itsdarklikehell

# Repo Archiving Suggestions
RAS_ENABLED=yes
RAS_DRY_RUN=yes
RAS_REPO=
RAS_ORG=itsdarklikehell

# Webhook Handler
WH_ENABLED=yes
WH_DRY_RUN=yes

# Model Router
MR_ENABLED=yes
MR_DRY_RUN=yes

# A2A Bridge
A2A_ENABLED=yes
A2A_DRY_RUN=yes
